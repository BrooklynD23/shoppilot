---
interface Props { title: string; description: string; themeLight?: string; themeDark?: string }
const { title, description, themeLight = '#ffffff', themeDark = '#000000' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeLight} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeDark} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
