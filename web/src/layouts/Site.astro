---
// Shared shell for every real page: fonts, tokens, skip link, header, footer.
import '@fontsource-variable/mona-sans/wdth.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/site.css';
import Base from './Base.astro';
import { nav, cta, footer } from '../data/site';

interface Props {
  title: string;
  description: string;
  surface?: 'night' | 'morning';   // body default surface; sections can switch with .night / .morning
  current?: string;                // nav href to mark aria-current
  skipTo?: string;                 // id of main target
  showVeoNote?: boolean;           // only pages that show Veo footage
  headerSurface?: 'night' | 'morning';
  footerSurface?: 'night' | 'morning';
}
const { title, description, surface = 'morning', current, skipTo = 'main', showVeoNote = false, headerSurface, footerSurface = 'morning' } = Astro.props;
const hs = headerSurface ?? surface;
---
<Base title={title} description={description} themeLight={surface === 'night' ? '#0f0e0c' : '#f7f6f3'} themeDark="#0f0e0c">
  <div class:list={[surface, "shell"]}>
    <a class="skip" href={`#${skipTo}`}>Skip to content</a>
    <header class:list={['site-header', hs]}>
      <div class="wrap">
        <a class="wordmark" href="/" aria-label="ShopPilot+ home">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="6" fill="currentColor"/><path d="M7 12.5l3 3 7-7" fill="none" stroke="#0f0e0c"stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          ShopPilot+
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li class={n.secondary ? 'nav-secondary' : undefined}><a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a></li>
            ))}
            <li><a class="btn btn-primary btn-sm nav-cta" href={cta.href} aria-current={current === cta.href ? 'page' : undefined}>{cta.label}</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <slot />
    <footer class:list={['site-footer', footerSurface]}>
      <div class="wrap">
        <div class="notes">
          <p>{footer.course}</p>
          <p>{footer.built}</p>
          {showVeoNote && <p>{footer.veo}</p>}
        </div>
        <ul>
          {footer.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    </footer>
  </div>
</Base>
