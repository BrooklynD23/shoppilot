---
// /app/: the working ShopPilot+ console (Operate mode, morning surface).
// One focal column: the team stage, one request bar, the plan. Inbox, outbox, audit and the
// graders' guide live in a drawer. Every record is rendered by src/scripts/console/* with
// textContent; no data in this HTML.
import '../../styles/page-console.css';
import Site from '../../layouts/Site.astro';
import Icon from '../../components/console/Icon.astro';
import Team from '../../components/console/Team.astro';
import Drawer from '../../components/console/Drawer.astro';
import Portrait from '../../components/console/Portrait.astro';
import { AGENTS } from '../../scripts/console/agents';
import { chips } from '../../data/v2';

const icons = ['tick', 'cross', 'clock', 'alert', 'undo', 'mail', 'shield', 'refresh', 'lock'] as const;
---
<Site
  title="ShopPilot+ console, Fern & Kiln demo store"
  description="Brief a team of seven agents on a private demo store. They plan, check and wait for your OK before money moves."
  surface="morning"
  headerSurface="night"
  current="/app/"
  footerSurface="morning"
  skipTo="ask"
>
  <main id="main" class="console-page" data-console>
    <div class="cbar">
      <div class="wrap cbar-in">
        <p class="cbar-store">
          <span id="store-name">Loading store</span>
          <span class="tag">Demo store</span>
        </p>
        <p class="cbar-meta" id="store-stats"></p>
        <p class="cbar-meta cbar-tag" id="stripe-tag">Stripe mode loading</p>
        <p class="cbar-meta" id="cost-meter">No AI cost yet this session</p>
        <div class="cbar-actions">
          <button class="cbar-btn" type="button" data-open="inbox">Inbox <span class="cbar-count cbar-count--bad" data-count="inbox"></span></button>
          <button class="cbar-btn" type="button" data-open="audit">Audit <span class="cbar-count" data-count="audit"></span></button>
          <button class="cbar-btn" type="button" data-open="guide">Guide</button>
          <button class="btn btn-line btn-sm cbar-reset" type="button" id="reset-btn">Reset demo store</button>
        </div>
      </div>
    </div>

    <div class="col banners">
      <p class="banner banner--fixture" id="fixture-banner" hidden><Icon name="alert" /><span id="fixture-text">Offline fixtures. Nothing here touches a server.</span></p>
      <p class="banner" id="mode-banner" hidden><Icon name="alert" /><span id="mode-text"></span></p>
      <p class="boot-line" id="notice-line" role="status" aria-live="polite"></p>
      <div class="gerror" id="error" role="alert" hidden>
        <p id="error-text"></p>
        <button class="btn btn-ink btn-sm" type="button" id="error-retry" hidden>Try again</button>
      </div>
    </div>

    <div class="col deck">
      <div class="deck-head">
        <h1 class="deck-h">Your team is in. <span class="cont">Say what needs doing.</span></h1>
        <button class="btn btn-line btn-sm" type="button" data-open="team">Team log</button>
      </div>

      <div class="brief">
        <Team />

        <form class="composer" id="ask" novalidate>
          <label class="sr-only" for="request-input">Ask your team</label>
          <textarea id="request-input" name="request" rows="2" maxlength="500" required placeholder="Ship yesterday's orders and email buyers tracking" aria-describedby="ask-hint"></textarea>
          <div class="composer-row">
            <ul class="chips" aria-label="Examples">
              {chips.map((c) => <li><button type="button" class="chip" data-prompt={c.prompt}>{c.label}</button></li>)}
            </ul>
            <div class="composer-go">
              <button class="btn btn-line btn-sm" type="button" id="replay-btn">Use recorded plan</button>
              <button class="btn btn-primary" type="submit" id="plan-btn">Plan it</button>
            </div>
          </div>
          <p class="ask-hint" id="ask-hint">Ctrl+Enter plans. Nothing runs until you press Run.</p>
        </form>
      </div>
    </div>

    {/* Mini team under the header while the team works off screen (team.ts). A copy of the stage, so hidden from AT. */}
    <div class="strip" id="strip" aria-hidden="true">
      <div class="col">
        <div class="strip-card">
          <ol class="strip-crew">
            {AGENTS.map((a) => <li class="member" data-agent={a.id} data-mood="idle"><Portrait id={a.id} /><span class="member-word"></span></li>)}
          </ol>
          <p class="strip-say"><span class="speech-who" id="strip-who"></span> <span id="strip-line"></span></p>
        </div>
      </div>
    </div>

    <div class="col">
      <section class="plan" id="plan" data-state="empty" aria-labelledby="plan-heading">
        <div class="plan-head">
          <h2 id="plan-heading" tabindex="-1">Plan</h2>
          <p class="plan-meta" id="plan-meta"></p>
        </div>
        <p class="sr-only" id="plan-status" aria-live="polite"></p>
        <p class="banner banner--replay" id="replay-banner" hidden><Icon name="refresh" /><span>Recorded plan (replay). The AI was not called for this one. Steps still run for real on your demo store.</span></p>

        <div class="plan-empty">
          <p>Your plan shows up here. Nothing runs until you approve it and press Run.</p>
        </div>

        <div class="plan-loading">
          <div class="loading-row">
            <p class="timer"><Icon name="clock" class="spin" /><span id="plan-timer">Planning… 0 s</span></p>
            <button class="btn btn-line btn-sm" type="button" id="cancel-btn">Cancel</button>
          </div>
          <p class="slow-line" id="slow-line" hidden>The AI is slow right now. <button class="btn btn-ink btn-sm" type="button" id="slow-replay">Use recorded plan</button></p>
          <div class="sk sk--steps" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>

        <div class="plan-error">
          <p class="plan-error-msg" id="plan-error-msg"></p>
          <div class="plan-error-actions">
            <button class="btn btn-ink btn-sm" type="button" id="err-retry">Try again</button>
            <button class="btn btn-line btn-sm" type="button" id="err-replay">Use recorded plan</button>
            <a class="btn btn-line btn-sm" id="err-fixtures" href="/app/?fixtures=happy">Open offline fixtures</a>
          </div>
        </div>

        <form class="plan-clarify" id="clarify">
          <p class="clarify-q" id="clarify-q"></p>
          <div class="clarify-options" id="clarify-options"></div>
          <label class="field-label" for="clarify-input">Your answer</label>
          <div class="clarify-row">
            <input id="clarify-input" type="text" maxlength="200" autocomplete="off" />
            <button class="btn btn-ink" type="submit">Send answer</button>
          </div>
        </form>

        <div class="plan-ready">
          <p class="notice" id="plan-blocked" hidden>
            <Icon name="shield" />
            <span id="plan-blocked-text"></span>
            <button class="linkbtn" type="button" id="see-it">See it</button>
          </p>
          <p class="notice notice--judge" id="plan-judge" hidden><Icon name="alert" /><span id="plan-judge-text"></span></p>
          <p class="plan-nothing" id="plan-nothing" hidden></p>
          <ol class="steps" id="steps"></ol>
        </div>

        <div class="run-bar" id="run-bar" hidden>
          <p class="out">
            <span class="out-label" id="out-label">Money out if you run</span>
            <span class="out-value num" id="money-out">$0.00</span>
            <span class="out-note"><span id="money-note"></span> <button class="linkbtn out-review" type="button" id="review-btn" hidden></button></span>
          </p>
          <button class="btn btn-ink" type="button" id="run-btn">Run approved steps</button>
          <button class="btn btn-line" type="button" id="audit-btn" data-open="audit" hidden>Open audit</button>
        </div>

        <section class="runlog" id="runlog" aria-labelledby="runlog-h" hidden>
          <h3 id="runlog-h">Run receipt</h3>
          <ol class="stream" id="stream" aria-live="polite"></ol>
        </section>
      </section>
    </div>

    <Drawer />
    <template id="tpl-icons">{icons.map((n) => <Icon name={n} />)}</template>
  </main>
</Site>

<script>
  import '../../scripts/console/console';
</script>
