---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../../styles/b.css';
import Base from '../../../layouts/Base.astro';
import Barcode from '../../../components/b/Barcode.astro';
import Icon from '../../../components/b/Icon.astro';
import VoidLabel from '../../../components/b/VoidLabel.astro';
import { copy, store, plan, inbox, forecast, money, moneyOutCents, chartPaths } from '../../../data/demo';

const c = chartPaths();
const needApproval = plan.steps.filter((s) => !s.approved).length;
const chips = ['Sunday cleanup', 'Stockout check', 'WISMO replies'];
const usage = `$${plan.usage.costUsd} · ${plan.usage.tokens} tok · cache ${plan.usage.cacheHitPct}%`;
const ticks = [0, 7, 14];
const base = 120 - 16;
---
<Base title="ShopPilot+ · Label" description={copy.sub} themeLight="#efe6cf" themeDark="#17150f">
  <a class="skip" href="#request-input">Skip to request</a>
  <header class="bar label">
    <a class="wordmark" href="/mockups/b/">ShopPilot+</a>
    <p class="bar__store"><span id="store-name">{store.name}</span> <span class="dim">{store.note}</span></p>
    <p class="bar__test" id="stripe-tag">Stripe <b>TEST</b></p>
    <p class="bar__cost num" id="cost-meter"><span class="sr-only">Session cost: </span>{usage}</p>
    <button class="btn" type="button" id="reset-btn">Reset demo store</button>
  </header>

  <div class="console">
    <main class="task" id="main">
      <h1 class="sr-only">Agent console</h1>

      <form class="req label" id="request-form" method="get" action="/mockups/b/console/">
        <label for="request-input">Ask ShopPilot+</label>
        <textarea id="request-input" name="request" rows="3" maxlength="500" required placeholder="e.g. Ship yesterday's orders and email buyers tracking">{copy.request}</textarea>
        <div class="req__row">
          <button class="btn btn--primary" id="plan-btn" type="submit">Plan it</button>
          <ul class="chips" id="suggestions" aria-label="Suggested requests">
            {chips.map((t) => <li><button class="chip" type="button">{t}</button></li>)}
          </ul>
        </div>
      </form>

      <section class="plan" id="plan" data-state="ready" aria-labelledby="plan-heading">
        <div class="plan__head label">
          <h2 id="plan-heading" tabindex="-1">Plan</h2>
          <p class="plan__count num">{plan.steps.length} steps · {needApproval} needs your approval</p>
          <div class="plan__id">
            <Barcode value={plan.planId} class="plan__bc" />
            <span class="mono">{plan.planId}</span>
          </div>
          <p class="plan__blocked" id="plan-blocked"><Icon name="cross" />1 inbox email was blocked from this plan. <a href="#inbox">See it</a></p>
        </div>

        <ol class="steps" id="steps">
          {plan.steps.map((s) => (
            <li class={`step label${s.movesMoney ? ' step--money' : ''}`} aria-labelledby={`${s.id}-t`}>
              <span class="step__n" aria-hidden="true">{s.n}</span>
              <div class="step__body">
                <div class="step__head">
                  <span class="tool mono">{s.tool}</span>
                  {s.valid && <span class="valid"><Icon name="tick" />Valid</span>}
                </div>
                <h3 class="step__title" id={`${s.id}-t`}><span class="sr-only">Step {s.n}: </span>{s.title}</h3>
                <p class="step__target">{s.target}</p>
                <p class="step__why"><span>Why:</span> {s.why}</p>

                <div class="diff">
                  <div class="diff__cell"><span class="diff__k">Before</span><span class="diff__v">{s.before}</span></div>
                  <Icon name="arrow" class="diff__arrow" />
                  <div class="diff__cell"><span class="diff__k">After</span><span class="diff__v">{s.after}</span></div>
                  {s.amountCents !== null && (
                    <p class="money">
                      <span class="money__k">{s.movesMoney ? 'Refund' : 'PO estimate'}</span>
                      <span class="money__v num">{money(s.amountCents)}</span>
                    </p>
                  )}
                </div>

                {s.tool === 'forecast_demand' && (
                  <figure class="fc">
                    <svg class="fc__svg" viewBox="0 0 280 120" role="img" aria-labelledby="fc-title fc-desc">
                      <title id="fc-title">Demand forecast for {forecast.product}</title>
                      <desc id="fc-desc">{forecast.caption}</desc>
                      <defs>
                        <pattern id="b-dither" width="3" height="3" patternUnits="userSpaceOnUse">
                          <rect class="fc__dot" x="0.5" y="0.5" width="1.2" height="1.2" />
                        </pattern>
                      </defs>
                      <path class="fc__band" d={c.band} fill="url(#b-dither)" />
                      <line class="fc__axis" x1="16" x2="264" y1={base} y2={base} />
                      {ticks.map((d) => (
                        <g>
                          <line class="fc__axis" x1={c.x(d)} x2={c.x(d)} y1={base} y2={base + 4} />
                          <text class="fc__tick" x={c.x(d)} y="118" text-anchor="middle">{d}</text>
                        </g>
                      ))}
                      <line class="fc__onhand" x1="16" x2="264" y1={c.onHandY} y2={c.onHandY} />
                      <text class="fc__lbl fc__lbl--red" x="262" y={c.onHandY - 4} text-anchor="end">On hand {forecast.onHand}</text>
                      <line class="fc__marker" x1={c.markerX} x2={c.markerX} y1="12" y2={base} />
                      <text class="fc__lbl" x={c.markerX + 4} y="12">Runs out ~day {forecast.daysToStockout}</text>
                      <path class="fc__p50" d={c.p50} />
                    </svg>
                    <figcaption>{forecast.caption}</figcaption>
                  </figure>
                )}

                <div class="step__foot">
                  <label class="approve">
                    <input type="checkbox" name="approve" value={s.id} checked={s.approved} />
                    <span>{s.movesMoney ? `Approve refund of ${money(s.amountCents ?? 0)} on order 1038` : 'Run this step'}</span>
                  </label>
                  <span class="step__id mono" aria-hidden="true">{plan.planId}/{s.id}</span>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <div class="run label" id="run-bar">
        <p class="run__text">Money out if you run: <span class="money money--inline num" id="money-out">{money(moneyOutCents)}</span> (Stripe test mode)</p>
        <button class="btn btn--primary" id="run-btn" type="button">Run approved steps</button>
      </div>
    </main>

    <aside class="rail" id="inbox" aria-label="Inbox, outbox and audit">
      <div class="rail__tabs label" role="tablist" aria-label="Rail">
        <button class="tab" role="tab" id="tab-inbox" aria-selected="true" aria-controls="panel-inbox" tabindex="0">Inbox <span class="tab__n">1 blocked</span></button>
        <button class="tab" role="tab" id="tab-outbox" aria-selected="false" aria-controls="panel-outbox" tabindex="-1">Outbox</button>
        <button class="tab" role="tab" id="tab-audit" aria-selected="false" aria-controls="panel-audit" tabindex="-1">Audit</button>
      </div>

      <div class="rail__panel" role="tabpanel" id="panel-inbox" aria-labelledby="tab-inbox">
        <ul class="mail" id="inbox-list">
          <li><VoidLabel /></li>
          {inbox.filter((e) => e.allowed).map((e) => (
            <li>
              <article class="ok label" aria-labelledby={`${e.id}-subj`}>
                <p class="stamp stamp--ok"><Icon name="tick" />ALLOWED</p>
                <p class="ok__from mono">{e.from}</p>
                <h3 class="ok__subj" id={`${e.id}-subj`}>{e.subject}</h3>
                <p class="ok__meta"><span>{e.reason}</span> <span class="num">score {e.score.toFixed(2)}</span></p>
              </article>
            </li>
          ))}
        </ul>
      </div>
      <div class="rail__panel" role="tabpanel" id="panel-outbox" aria-labelledby="tab-outbox" hidden>
        <p>Never sent. Emails stay in this app.</p>
      </div>
      <div class="rail__panel" role="tabpanel" id="panel-audit" aria-labelledby="tab-audit" hidden>
        <p>Nothing has run yet.</p>
      </div>
    </aside>
  </div>
</Base>
