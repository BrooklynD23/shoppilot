---
import '@fontsource-variable/red-hat-display/wght.css';
import '@fontsource-variable/red-hat-text/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../../styles/c.css';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/c/Icon.astro';
import Slab from '../../../components/c/Slab.astro';
import Misfit from '../../../components/c/Misfit.astro';
import { copy, plan, inbox, store, forecast, money, moneyOutCents, chartPaths } from '../../../data/demo';

const K = '/mockups/c';
const u = plan.usage;
const c = chartPaths();
const needApproval = plan.steps.filter((s) => !s.approved).length;
// What each step's 1:1 call-out magnifies: the money, or the one argument that matters.
const callouts: Record<string, { big: string; unit: string; arg?: string; money?: boolean }> = {
  s1: { big: '3', unit: 'orders, USPS', arg: '1041 1042 1043' },
  s2: { big: '3', unit: 'tracking emails' },
  s4: { big: money(31200), unit: 'PO estimate, nothing charged', money: true },
  s5: { big: money(2400), unit: 'Money out, Stripe test', money: true },
};
const blocked = inbox.filter((e) => !e.allowed).length;
---
<Base title="ShopPilot+ · Build Book · Console" description="Agent console mockup: a checked plan for the Fern & Kiln demo store." themeLight="#a9d8f2" themeDark="#0e2a3d">
  <a class="skip" href="#request">Skip to request</a>
  <header class="top top-console">
    <a class="wordmark" href={`${K}/`}>
      <svg class="mark" viewBox="0 0 40 32" aria-hidden="true" focusable="false">
        <Slab x={4} y={18} w={24} h={10} dx={8} dy={-6} />
        <Slab x={4} y={8} w={24} h={10} dx={8} dy={-6} kind="new" top />
      </svg>
      ShopPilot+
    </a>
    <p class="store"><span id="store-name">{store.name}</span> <span class="muted">{store.note}</span></p>
    <p class="tag" id="stripe-tag">Stripe TEST</p>
    <p class="meter num" id="cost-meter">${u.costUsd.toFixed(3)} · {u.tokens} tok · cache {u.cacheHitPct}%</p>
    <button class="btn btn-line" type="button" id="reset-btn">Reset demo store</button>
    <nav aria-label="Main">
      <ul>
        <li><a href={`${K}/console/`} aria-current="page">Agent console</a></li>
        <li><a href="/">How it works</a></li>
        <li><a href="/">Report</a></li>
      </ul>
    </nav>
  </header>

  <div class="console">
    <main class="task">
      <h1 class="sr-only">ShopPilot+ agent console</h1>
      <form class="callout request" id="request-form" method="get" action={`${K}/console/`}>
        <label for="request">Ask ShopPilot+</label>
        <textarea id="request" name="q" rows="4" maxlength="500" required>{copy.request}</textarea>
        <div class="request-row">
          <button class="btn btn-ink" type="submit" id="plan-btn">Plan it</button>
          <ul class="chips" id="suggestions" aria-label="Suggested requests">
            <li><button class="chip" type="button">Sunday cleanup</button></li>
            <li><button class="chip" type="button">Stockout check</button></li>
            <li><button class="chip" type="button">WISMO replies</button></li>
          </ul>
        </div>
      </form>

      <section class="sheet plan" id="plan" aria-labelledby="plan-heading">
        <div class="plan-head">
          <h2 id="plan-heading">Plan</h2>
          <p class="num">{plan.steps.length} steps · {needApproval} needs your approval</p>
        </div>
        <p class="blocked-note" id="plan-blocked">
          <Icon name="cross" />
          <span>{blocked} inbox email was blocked from this plan. <a href="#inbox">See it</a></span>
        </p>
        <ol class="steps" id="steps">
          {plan.steps.map((s) => {
            const co = callouts[s.id];
            return (
              <li class:list={['frame', { 'has-chart': s.tool === 'forecast_demand' }]} id={`step-${s.id}`}>
                <span class="frame-n num">{s.n}</span>
                <div class="frame-body">
                  <p class="tool"><code>{s.tool}</code></p>
                  <h3>{s.title}</h3>
                  <p class="target">{s.target}</p>
                  <p class="why"><span class="k">Why</span> {s.why}</p>
                  <div class="diff">
                    <p class="before"><span class="k">Before</span> {s.before}</p>
                    <svg class="seat-arrow" viewBox="0 0 48 16" aria-hidden="true" focusable="false"><path class="shaft" d="M2 8h34" /><path class="head" d="M34 2l10 6-10 6z" /></svg>
                    <p class="after"><span class="k">After</span> {s.after}</p>
                  </div>
                  <div class="frame-foot">
                    <p class="valid"><Icon name="tick" />Valid</p>
                    <label class:list={['approve', { 'approve-money': s.movesMoney }]}>
                      <input type="checkbox" name="approve" value={s.id} checked={s.approved} />
                      {s.movesMoney ? `Approve refund of ${money(s.amountCents ?? 0)} on order 1038` : 'Run this step'}
                    </label>
                  </div>
                </div>
                {s.tool === 'forecast_demand' ? (
                  <figure class="callout zoom chart">
                    <span class="scale">1:1</span>
                    <svg viewBox="0 0 280 120" role="img" aria-labelledby="fc-t fc-d">
                      <title id="fc-t">Demand forecast for {forecast.product}</title>
                      <desc id="fc-d">{forecast.caption}</desc>
                      <path class="fc-band" d={c.band} />
                      <path class="fc-p50" d={c.p50} />
                      <path class="fc-hand" d={`M${c.x(0)} ${c.onHandY}H${c.x(14)}`} />
                      <text class="fc-t" x={c.x(14)} y={c.onHandY - 5} text-anchor="end">On hand {forecast.onHand}</text>
                      <path class="fc-mark" d={`M${c.markerX} 12V${120 - 16}`} />
                      <text class="fc-t" x={c.markerX + 5} y={20}>Runs out ~day {forecast.daysToStockout}</text>
                      {[0, 7, 14].map((d) => <text class="fc-tick" x={c.x(d)} y={117} text-anchor="middle">{d}</text>)}
                    </svg>
                    <figcaption>{forecast.caption}</figcaption>
                  </figure>
                ) : co && (
                  <div class:list={['callout', 'zoom', { money: co.money }]}>
                    <span class="scale">1:1</span>
                    <span class="big num">{co.big}</span>
                    <span class="unit">{co.unit}</span>
                    {co.arg && <code class="arg">{co.arg}</code>}
                  </div>
                )}
              </li>
            );
          })}
        </ol>
      </section>

      <div class="runbar" id="run-bar">
        <p id="money-out">Money out if you run: <strong class="num">{money(moneyOutCents)}</strong> (Stripe test mode)</p>
        <button class="btn btn-yellow" type="button" id="run-btn">Run approved steps</button>
      </div>
    </main>

    <aside class="rail" id="inbox" aria-label="Inbox, outbox and audit">
      <div class="tabs" role="tablist" aria-label="Rail">
        <button type="button" role="tab" id="tab-inbox" aria-selected="true" aria-controls="inbox-list" tabindex="0">Inbox <span class="tab-badge"><Icon name="cross" />{blocked} blocked</span></button>
        <button type="button" role="tab" id="tab-outbox" aria-selected="false" tabindex="-1">Outbox</button>
        <button type="button" role="tab" id="tab-audit" aria-selected="false" tabindex="-1">Audit</button>
      </div>
      <ul class="mail" id="inbox-list" role="tabpanel" aria-labelledby="tab-inbox">
        {inbox.map((e) => (
          <li class:list={['msg', e.allowed ? 'msg-ok' : 'msg-bad']}>
            {!e.allowed && <Misfit class="msg-art" />}
            <p class:list={['stamp', e.allowed ? 'stamp-ok' : 'stamp-blocked']}><Icon name={e.allowed ? 'tick' : 'cross'} />{e.allowed ? 'ALLOWED' : 'BLOCKED'}</p>
            <h3>{e.subject}</h3>
            <p class="from"><code>{e.from}</code></p>
            <p class="reason">{e.reason}</p>
            {!e.allowed && <p class="meta"><code>{e.label}</code> <span>score <b class="num">{e.score.toFixed(2)}</b></span></p>}
          </li>
        ))}
      </ul>
    </aside>
  </div>
</Base>
