---
// ShopPilot+ landing, night to morning. Night: hero footage, the inbox, the team, the guard.
// Dawn: the morning footage under the finished run. Morning: product, planned pricing, FAQ.
// Copy: src/data/landing.ts. Product facts: src/data/run.ts (the console's recorded fixture). Product fragments are [data-ui].
// JS: only the footage toggle (src/scripts/landing/video.ts). The hero checkbox is CSS (:has).
import Site from '../layouts/Site.astro';
import '../styles/page-landing.css'; // after Site, so page rules win over site.css at equal specificity
import BgVideo from '../components/landing/BgVideo.astro';
import HeroStage from '../components/landing/HeroStage.astro';
import InboxNight from '../components/landing/InboxNight.astro';
import TeamRoom from '../components/landing/TeamRoom.astro';
import RunDone from '../components/landing/RunDone.astro';
import Bento from '../components/landing/Bento.astro';
import Icon from '../components/landing/Icon.astro';
import * as L from '../data/landing';
import { blocked } from '../data/run';

const APP = '/app/';
---
<Site title={L.hero.title} description={L.hero.sub} surface="night" current="/" showVeoNote footerSurface="morning">
  <main id="main" class="landing">
    <!-- 1. Hero: night footage, scrim, the product layered flat on top -->
    <section class="hero" aria-labelledby="hero-title">
      <BgVideo name="night" eager cssFallback class="hero-vid" label="background video" />
      <div class="wrap hero-copy">
        <h1 id="hero-title">{L.hero.h1.map((line) => <span>{line}</span>)}</h1>
        <div class="hero-row">
          <p class="hero-sub" data-hero-sub>{L.hero.sub}</p>
          <div class="hero-cta">
            <a class="btn btn-primary btn-lg" href={APP}>{L.hero.cta}</a>
            <p class="hero-note">{L.hero.note}</p>
          </div>
        </div>
      </div>
      <div class="wrap"><HeroStage /></div>
    </section>

    <!-- 2. Problem: a real quote beside the inbox at 21:50 -->
    <section class="problem wrap" aria-labelledby="problem-title">
      <h2 id="problem-title" class="sr-only">{L.problem.h2}</h2>
      <figure class="quote">
        <blockquote><p>“{L.problem.quote}”</p></blockquote>
        <figcaption>{L.problem.source}</figcaption>
      </figure>
      <InboxNight />
    </section>

    <!-- 3. Team: seven specialists, one approver, one run as they report it -->
    <section class="team wrap" id="team" aria-labelledby="team-title">
      <div class="sh sh--center">
        <h2 id="team-title">{L.team.h2}</h2>
        <p>{L.team.line}</p>
      </div>
      <TeamRoom />
    </section>

    <!-- 4. Safety: the hard caps beside the blocked email, shown as text -->
    <section class="safety wrap" id="safety" aria-labelledby="safety-title">
      <div class="sh">
        <h2 id="safety-title">{L.safety.h2}</h2>
        <p>{L.safety.line}</p>
      </div>
      <div class="safety-grid">
        <figure class="caps panel" data-ui>
          <figcaption class="panel-head"><Icon name="lock" /><span class="panel-title">{L.safety.capsNote}</span></figcaption>
          <table class="caps-t">
            <tbody>
              {L.safety.caps.map((c) => <tr><th scope="row">{c.name}</th><td class="num">{c.value}</td></tr>)}
            </tbody>
          </table>
          <p class="caps-src"><code>{L.safety.capsSource}</code></p>
        </figure>
        <article class="mail-big panel" data-ui aria-label="Blocked email, demo store">
          <header class="panel-head">
            <span class="stamp stamp--big">BLOCKED</span>
            <p class="panel-meta">Never sent to the planner</p>
            <span class="tag">Demo store</span>
          </header>
          <div class="mb-body">
            <p class="mb-from">From <span class="addr">{blocked.from}</span></p>
            <p class="mb-raw">{blocked.body}</p>
          </div>
          <p class="mb-verdict"><Icon name="shield" /><span>{blocked.reason}</span><code class="id">Guard label {blocked.label}, score {blocked.score}</code></p>
        </article>
      </div>
    </section>

    <!-- 5. Dawn: night fades to tissue; the morning footage under the finished run -->
    <section class="dawn morning" aria-labelledby="dawn-title">
      <div class="dawn-fade" aria-hidden="true"></div>
      <div class="wrap dawn-inner">
        <div class="sh">
          <h2 id="dawn-title">{L.morning.h2}</h2>
          <p>{L.morning.line}</p>
        </div>
        <div class="dawn-stage">
          <BgVideo name="morning" class="dawn-vid" label="morning video" />
          <RunDone />
        </div>
      </div>
    </section>

    <div class="morning">
      <!-- 6. Product: the Forecaster's two tiles, each a real fragment -->
      <section class="product wrap" id="product" aria-labelledby="product-title">
        <div class="sh"><h2 id="product-title">{L.product.h2}</h2></div>
        <Bento />
      </section>

      <!-- 7. Planned pricing: a labelled simulation -->
      <section class="pricing wrap" id="pricing" aria-labelledby="pricing-title">
        <div class="pricing-head">
          <h2 id="pricing-title">{L.pricing.h2}</h2>
          <p class="pricing-label"><Icon name="info" />{L.pricing.label}</p>
        </div>
        <ul class="tiers">
          {L.pricing.tiers.map((t) => (
            <li class:list={['tier', { 'tier--now': t.live }]}>
              <h3>{t.name}</h3>
              <p class="tier-price"><span class="num">{t.price}</span>{t.period && <span class="tier-period">{t.period}</span>}</p>
              <ul class="tier-feats">
                {t.features.map((f) => <li><Icon name="tick" />{f}</li>)}
              </ul>
              {t.live
                ? <a class="btn btn-primary" href={APP}>{t.cta}</a>
                : <button class="btn btn-line" type="button" disabled>{t.cta}</button>}
            </li>
          ))}
        </ul>
      </section>

      <!-- 8. FAQ -->
      <section class="faq wrap" id="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">{L.faq.h2}</h2>
        <div class="faq-list">
          {L.faq.items.map((f) => (
            <details class="qa">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- 9. Closing -->
      <section class="closing" aria-labelledby="closing-title">
        <div class="wrap closing-inner">
          <h2 id="closing-title">{L.closing.h2}</h2>
          <a class="btn btn-primary btn-lg" href={APP}>{L.closing.cta}</a>
        </div>
      </section>
    </div>
  </main>
</Site>

<script>
  import '../scripts/landing/video';
</script>
