---
import '@fontsource-variable/mona-sans/wdth.css';
import '@fontsource-variable/jetbrains-mono';
import '../../../styles/v2-1.css';
import Base from '../../../layouts/Base.astro';
import PlanCard from '../../../components/v2-1/PlanCard.astro';
import { chips } from '../../../data/v2';
import { store, copy, plan, inbox, money } from '../../../data/demo';

const ROOT = '/v2/1/';
const blocked = inbox.filter((m) => !m.allowed);
const allowed = inbox.filter((m) => m.allowed);
const refund = plan.steps.find((s) => s.movesMoney)!;
---
<Base title="ShopPilot+ console, Fern & Kiln demo store" description="ShopPilot+ agent console: plan, check, approve, run and undo on the Fern & Kiln demo store.">
  <a class="skip" href="#request-input">Skip to request</a>

  <header class="con-head">
    <div class="con-head__in">
      <a class="wordmark" href={ROOT}>ShopPilot+</a>
      <p class="con-store" id="store-name"><strong>{store.name}</strong> <span class="tag">Demo store</span></p>
      <p class="con-meta" id="stripe-tag">Stripe test mode</p>
      <p class="con-meta money" id="cost-meter">${plan.usage.costUsd} this plan, cache {plan.usage.cacheHitPct}%</p>
      <nav aria-label="Console">
        <ul class="con-nav">
          <li><a href={ROOT}>About ShopPilot+</a></li>
        </ul>
      </nav>
      <button class="btn btn--quiet" type="button" id="reset-btn">Reset demo store</button>
    </div>
  </header>

  <main class="console" id="main">
    <div class="task">
      <h1 class="con-h1">{copy.h1}</h1>

      <form class="ask" id="request-form" novalidate>
        <label for="request-input">Ask ShopPilot+</label>
        <textarea id="request-input" name="request" rows="3" maxlength="500" required aria-describedby="request-status">{copy.request}</textarea>
        <div class="ask__row">
          <button class="btn btn--primary" type="submit" id="plan-btn">Plan it</button>
          <ul class="chips" id="suggestions" aria-label="Example requests">
            {chips.map((c) => (
              <li><button class="chip" type="button" data-prompt={c.prompt}>{c.label}</button></li>
            ))}
          </ul>
        </div>
        <p class="ask__status" id="request-status" role="status"></p>
      </form>

      <PlanCard variant="full" />

      <div class="runbar" id="run-bar">
        <div class="runbar__text">
          <p id="money-out">Money out if you run: <strong class="money" id="money-out-amt">{money(0)}</strong> (Stripe test mode)</p>
          <p class="runbar__hint" id="money-hint">Tick step 5 to add the {money(refund.amountCents ?? 0)} refund. Card refunds cannot be undone.</p>
        </div>
        <button class="btn btn--primary" type="button" id="run-btn">Run approved steps</button>
      </div>

      <section class="runlog" aria-labelledby="runlog-h">
        <h2 id="runlog-h">Run log</h2>
        <ol id="stream" aria-live="polite">
          <li class="runlog__empty">Nothing has run yet. Approved steps run in order and each writes a receipt.</li>
        </ol>
      </section>
    </div>

    <aside class="rail" id="inbox" aria-label="Inbox, Outbox and Audit">
      <div class="tabs" role="tablist" aria-label="Store mail and audit">
        <button class="tab" role="tab" id="tab-inbox" aria-controls="panel-inbox" aria-selected="true" type="button">Inbox <span class="tab__n">(1 blocked)</span></button>
        <button class="tab" role="tab" id="tab-outbox" aria-controls="panel-outbox" aria-selected="false" tabindex="-1" type="button">Outbox</button>
        <button class="tab" role="tab" id="tab-audit" aria-controls="panel-audit" aria-selected="false" tabindex="-1" type="button">Audit</button>
      </div>

      <div class="panel" role="tabpanel" id="panel-inbox" aria-labelledby="tab-inbox" tabindex="0">
        <ul class="mails" id="inbox-list">
          {blocked.map((m) => (
            <li class="mail mail--blocked" id={m.id}>
              <div class="mail__head">
                <span class="stamp">BLOCKED</span>
                <code class="mail__id">{m.id}</code>
              </div>
              <p class="mail__subj">{m.subject}</p>
              <p class="mail__from wrap-any">{m.from}</p>
              <p class="mail__verdict">{m.reason}</p>
              <details class="disclose">
                <summary>Technical details</summary>
                <p>Guard label <code>{m.label}</code>, score <span class="money">{m.score}</span>.</p>
              </details>
            </li>
          ))}
          {allowed.map((m) => (
            <li class="mail mail--ok" id={m.id}>
              <div class="mail__head">
                <span class="allowed">
                  <svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" /></svg>
                  Allowed
                </span>
                <code class="mail__id">{m.id}</code>
              </div>
              <p class="mail__subj">{m.subject}</p>
              <p class="mail__from wrap-any">{m.from}</p>
              <p class="mail__body">{m.preview}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="panel" role="tabpanel" id="panel-outbox" aria-labelledby="tab-outbox" tabindex="0" hidden>
        <p class="fine">Never sent. Emails stay in this app.</p>
        <p class="empty" id="outbox-empty">Nothing queued yet. Step 2 adds 3 tracking emails when it runs.</p>
      </div>

      <div class="panel" role="tabpanel" id="panel-audit" aria-labelledby="tab-audit" tabindex="0" hidden>
        <ol class="receipt" id="audit-list">
          <li class="empty">No actions yet. Every step that runs writes a receipt here.</li>
        </ol>
      </div>
    </aside>
  </main>

  <footer class="foot foot--con">
    <div class="foot__in">
      <p class="foot__course">Recorded plan (replay) on a seeded demo store. Nothing here touches a real shop, card or inbox.</p>
    </div>
  </footer>
</Base>

<script>
  import '../../../scripts/v2-1/console';
</script>
