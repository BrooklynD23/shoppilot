---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../../styles/v2-3.css';
import Base from '../../../layouts/Base.astro';
import StepRow from '../../../components/v2-3/StepRow.astro';
import EmailRow from '../../../components/v2-3/EmailRow.astro';
import ForecastChart from '../../../components/v2-3/ForecastChart.astro';
import Icon from '../../../components/v2-3/Icon.astro';
import { plan, inbox, store, copy, money, moneyOutCents } from '../../../data/demo';
import { chips, footer } from '../../../data/v2';

const ROOT = '/v2/3/';
const u = plan.usage;
const needApproval = plan.steps.filter((s) => !s.approved).length;
---
<Base title="ShopPilot+ console | Fern & Kiln demo store" description="Plan, check and approve the Sunday cleanup on the Fern & Kiln demo store." themeLight="#f4f2fb" themeDark="#f4f2fb">
  <div class="v3 app">
    <a class="skip" href="#request-input">Skip to request</a>
    <header class="app-top">
      <nav class="app-nav" aria-label="App">
        <a class="wordmark" href={ROOT}>ShopPilot+</a>
      </nav>
      <div class="app-store">
        <h1 id="store-name">{store.name}</h1>
        <span class="tag-src">Demo store</span>
      </div>
      <p class="app-meta" id="stripe-tag">Stripe test mode</p>
      <p class="app-meta" id="cost-meter"><span class="num">${u.costUsd.toFixed(3)}</span> this plan, cache {u.cacheHitPct}%</p>
      <button class="btn btn-line btn-sm" type="button" id="reset-btn">Reset demo store</button>
    </header>

    <main id="main" class="app-grid">
      <div class="task">
        <form id="request-form" class="request" novalidate>
          <label for="request-input" class="req-label">Ask ShopPilot+</label>
          <textarea id="request-input" name="request" rows="3" maxlength="500" required autocomplete="off" aria-describedby="request-msg">{copy.request}</textarea>
          <div class="req-actions">
            <button class="btn btn-primary" type="submit" id="plan-btn">Plan it</button>
            <ul class="chips" aria-label="Suggested requests">
              {chips.map((c) => <li><button class="chip" type="button" data-prompt={c.prompt}>{c.label}</button></li>)}
            </ul>
          </div>
          <p id="request-msg" class="req-msg" role="status" aria-live="polite"></p>
        </form>

        <section id="plan" class="plan panel" aria-labelledby="plan-h">
          <div class="plan-head">
            <h2 id="plan-h" tabindex="-1">Plan</h2>
            <p class="plan-count">{plan.steps.length} steps, {needApproval} needs your approval</p>
            <p class="replay"><Icon name="undo" />Recorded plan (replay)</p>
          </div>
          <p class="blocked-note"><Icon name="alert" /><span>1 inbox email was blocked from this plan. <a href="#inbox">See it</a></span></p>
          <ol class="steps plan-steps">
            {plan.steps.map((s) => (
              <StepRow step={s} interactive>
                {s.tool === 'forecast_demand' && <ForecastChart uid="fc-app" />}
              </StepRow>
            ))}
          </ol>
        </section>

        <div class="runbar">
          <p>Money out if you run: <span class="money">{money(moneyOutCents)}</span> <span class="runbar-note">(Stripe test mode)</span></p>
          <button class="btn btn-primary" type="button" id="run-btn">Run approved steps</button>
        </div>

        <section class="log panel" aria-labelledby="log-h">
          <h2 id="log-h">Run log</h2>
          <p class="log-empty" id="log-empty">Nothing has run yet. Tick the steps you want, then run them.</p>
          <ol class="runlog" id="runlog" aria-live="polite"></ol>
        </section>

      </div>

      <aside id="inbox" class="rail" aria-label="Inbox, Outbox and Audit">
        <div class="tabs" role="tablist" aria-label="Store mail and log">
          <button role="tab" id="tab-inbox" aria-controls="panel-inbox" aria-selected="true" type="button">Inbox <span class="tab-n">(1 blocked)</span></button>
          <button role="tab" id="tab-outbox" aria-controls="panel-outbox" aria-selected="false" tabindex="-1" type="button">Outbox</button>
          <button role="tab" id="tab-audit" aria-controls="panel-audit" aria-selected="false" tabindex="-1" type="button">Audit</button>
        </div>
        <div role="tabpanel" id="panel-inbox" aria-labelledby="tab-inbox" class="tabpanel">
          <ul class="mails">
            {inbox.map((e) => <EmailRow email={e} technical />)}
          </ul>
        </div>
        <div role="tabpanel" id="panel-outbox" aria-labelledby="tab-outbox" class="tabpanel" hidden>
          <p class="rail-note">Never sent. Emails stay in this app.</p>
          <p class="rail-empty" id="outbox-empty">No emails yet. Step 2 drafts 3 tracking emails here when it runs.</p>
          <ul class="rail-list" id="outbox-list"></ul>
        </div>
        <div role="tabpanel" id="panel-audit" aria-labelledby="tab-audit" class="tabpanel" hidden>
          <p class="rail-empty" id="audit-empty">Nothing logged yet. Every step you run writes a receipt here.</p>
          <ul class="rail-list" id="audit-list"></ul>
        </div>
      </aside>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <a class="wordmark" href={ROOT}>ShopPilot+</a>
        <ul class="foot-links">
          {footer.links.map((l) => <li><a href={l.href === 'app/' ? `${ROOT}app/` : l.href}>{l.label}</a></li>)}
        </ul>
        <p class="foot-course">{footer.course}</p>
      </div>
    </footer>
  </div>
</Base>

<script>
  import '../../../scripts/v2-3/console.ts';
</script>
