---
import '@fontsource-variable/hubot-sans/wdth.css';
import '@fontsource-variable/mona-sans/wdth.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../../styles/v2-4.css';
import Base from '../../../layouts/Base.astro';
import PlanCard from '../../../components/v2-4/PlanCard.astro';
import ForecastChart from '../../../components/v2-4/ForecastChart.astro';
import {
  hero, proof, proofNote, howSteps, safety, anomalies, forecastCopy,
  problem, pricing, pricingLabel, faq, closing, footer,
} from '../../../data/v2';
import { inbox } from '../../../data/demo';

// Flip to true once the files from VEO-PROMPTS.md sit in public/v2/media/
// (hero.webm, hero.mp4, hero-poster.avif). The pause button wires itself up.
const HERO_VIDEO = false;
// Flip to true once the OBS recording sits at public/v2/media/film.mp4 (+ film-poster.avif).
const FILM_VIDEO = false;

const APP = '/v2/4/app/';
const blocked = inbox[0];
const howPill: Record<string, string> = { plan: 'planned', check: 'checked', approve: 'approval', run: 'done', undo: 'undone' };
const [h1a, h1b] = hero.h1.split('. ');
---
<Base title="ShopPilot+: safe autopilot for your shop" description={`${hero.h1} ${hero.sub}`}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <a class="wordmark" href="/v2/4/">ShopPilot+</a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        <li><a href="#how">How it works</a></li>
        <li><a href="#safety">Safety</a></li>
        <li><a href="#pricing">Pricing</a></li>
      </ul>
    </nav>
    <a class="btn btn--primary head-cta" href={APP}>{hero.cta}</a>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-h1">
      <div class="frame">
        {HERO_VIDEO ? (
          <video class="frame-media" data-hero-video autoplay muted loop playsinline preload="metadata" poster="/v2/media/hero-poster.avif" aria-hidden="true">
            <source src="/v2/media/hero.webm" type="video/webm" />
            <source src="/v2/media/hero.mp4" type="video/mp4" />
          </video>
        ) : (
          <div class="frame-media dusk" aria-hidden="true"></div>
          <p class="frame-label">Video placeholder: Veo loop of a packing table at dusk (see VEO-PROMPTS.md)</p>
        )}
        <button class="frame-pause" type="button" data-hero-pause hidden aria-label="Pause background video">
          <svg class="icon icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" /></svg>
          <svg class="icon icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
        </button>
        <div class="hero-copy">
          <h1 id="hero-h1"><span>{h1a}.</span> <span>{h1b}</span></h1>
          <p class="hero-sub">{hero.sub}</p>
          <a class="btn btn--primary btn--lg" href={APP}>{hero.cta}</a>
        </div>
      </div>
      <p class="hero-note">{hero.ctaNote}</p>
      <div class="hero-card">
        <PlanCard compact idp="hero" />
      </div>
    </section>

    <section class="proof wrap" aria-labelledby="proof-h">
      <h2 id="proof-h" class="h-small">Measured on the prototype</h2>
      <dl class="proof-list">
        {proof.map((p) => (
          <div class="proof-item">
            <dt class="proof-value">{p.value}</dt>
            <dd class="proof-label">{p.label}</dd>
            <dd class="source">{p.source}</dd>
          </div>
        ))}
      </dl>
      <p class="proof-note">{proofNote}</p>
    </section>

    <section id="how" class="how wrap" aria-labelledby="how-h">
      <div class="how-head">
        <h2 id="how-h">How a request runs</h2>
        <p>One sentence in, five checked steps out. The film below will show the real console doing exactly this.</p>
      </div>
      <figure class="film">
        <div class="film-frame">
          {FILM_VIDEO ? (
            <video class="frame-media" controls preload="none" poster="/v2/media/film-poster.avif">
              <source src="/v2/media/film.mp4" type="video/mp4" />
            </video>
          ) : (
            <p class="frame-label">Product film: 30 s screen recording of the real console, recorded after the 11-02 build freeze</p>
            <button class="film-play" type="button" disabled aria-label="Play product film (not recorded yet)">
              <svg viewBox="0 0 80 80" aria-hidden="true"><circle cx="40" cy="40" r="38" /><path d="M33 27v26l21-13z" /></svg>
            </button>
          )}
        </div>
        <figcaption>Placeholder. No frames are shown until the recording exists, and every frame will come from the real app.</figcaption>
      </figure>
      <ol class="how-steps">
        {howSteps.map((s, i) => (
          <li class="how-step">
            <span class="how-n" aria-hidden="true">{i + 1}</span>
            <h3>{s.name}</h3>
            <span class={`pill pill--${howPill[s.key]}`}>{s.pill}</span>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="safety" class="safety wrap" aria-labelledby="safety-h">
      <div class="safety-story">
        <h2 id="safety-h">{safety.heading}</h2>
        <p class="lead">{safety.body}</p>
        <article class="email" aria-label="The blocked email">
          <p class="email-from"><span class="k">From</span> <span class="addr">{blocked.from}</span></p>
          <p class="email-subject">{blocked.subject}</p>
          <p class="email-preview">{blocked.preview}</p>
          <p class="verdict"><span class="stamp">BLOCKED</span> <span>{safety.verdictPlain}</span></p>
          <details class="tech">
            <summary>Technical details</summary>
            <p>{safety.technical}</p>
          </details>
        </article>
      </div>
      <div class="safety-rules">
        <h3>Limits the agent cannot cross</h3>
        <dl class="caps">
          {safety.caps.map((c) => (
            <div><dt>{c.name}</dt><dd>{c.text}</dd></div>
          ))}
        </dl>
        <h3>Audit receipt</h3>
        <ol class="receipt">
          {safety.auditReceipt.map((r) => (
            <li class="receipt-row">
              <span class="receipt-ts mono">{r.ts}</span>
              <span class="receipt-what">
                <span class="receipt-summary">{r.summary}</span>
                <span class="receipt-meta"><code class="tool">{r.tool}</code> <span class="mono id">{r.id}</span></span>
              </span>
              <span class="receipt-undo">
                {r.undo ? <span class="undo-ok">Undo available</span> : <><span class="undo-no">No undo</span> <span class="pill pill--irreversible">Irreversible</span></>}
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="forecast" aria-labelledby="fc-h">
      <div class="wrap forecast-grid">
        <div class="forecast-copy">
          <h2 id="fc-h">{forecastCopy.heading}</h2>
          <p>{forecastCopy.body}</p>
        </div>
        <div class="forecast-chart"><ForecastChart idp="land" /></div>
        <div class="anom-head">
          <h3>{forecastCopy.anomaliesHeading}</h3>
          <span class="tag">Demo store</span>
        </div>
        <ul class="anom-list">
          {anomalies.map((a) => (
            <li>
              <span class="anom-order">Order <span class="mono">{a.order}</span></span>
              <span class="anom-reason">{a.reason}</span>
              <span class="anom-score">Flag score {a.score}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="problem wrap" aria-labelledby="problem-h">
      <h2 id="problem-h" class="sr-only">The problem</h2>
      <figure class="quote">
        <blockquote><p>{problem.quote}</p></blockquote>
        <figcaption>{problem.source}</figcaption>
      </figure>
      <p class="fear">{problem.fear}</p>
    </section>

    <section id="pricing" class="pricing wrap" aria-labelledby="pricing-h">
      <h2 id="pricing-h">Planned pricing</h2>
      <p class="pricing-label">{pricingLabel}</p>
      <div class="tiers">
        {pricing.map((t, i) => (
          <div class:list={['tier', i === 0 && 'tier--demo']}>
            <h3>{t.name}</h3>
            <p class="tier-price"><span class="money">{t.price}</span> <span class="tier-period">{t.period}</span></p>
            <p class="tier-blurb">{t.blurb}</p>
            <ul>{t.features.map((f) => <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>{f}</li>)}</ul>
            {i === 0 ? <a class="btn btn--primary" href={APP}>{t.cta}</a> : <button class="btn btn--quiet" type="button" disabled>{t.cta}</button>}
          </div>
        ))}
      </div>
    </section>

    <section class="faq wrap" aria-labelledby="faq-h">
      <h2 id="faq-h">Honest answers and limits</h2>
      <div class="faq-list">
        {faq.map((f) => (
          <details>
            <summary>{f.q}<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6" /></svg></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="closing wrap" aria-labelledby="closing-h">
      <div class="closing-band dusk-surface">
        <h2 id="closing-h">{closing.heading}</h2>
        <p>{closing.body}</p>
        <a class="btn btn--primary btn--lg" href={APP}>{hero.cta}</a>
      </div>
    </section>
  </main>

  <footer class="site-foot wrap">
    <nav aria-label="Footer">
      <ul>
        <li><a href={APP}>App</a></li>
        {footer.links.slice(1).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <p>{footer.course}</p>
    <p>Hero video generated with Google Veo (placeholder until generated)</p>
  </footer>
</Base>

<script>
  import '../../../scripts/v2-4/hero-video.ts';
</script>
