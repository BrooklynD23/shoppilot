---
import '@fontsource-variable/hubot-sans/wdth.css';
import '@fontsource-variable/mona-sans/wdth.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../../../styles/v2-4.css';
import Base from '../../../../layouts/Base.astro';
import PlanCard from '../../../../components/v2-4/PlanCard.astro';
import { chips } from '../../../../data/v2';
import { copy, inbox, money, moneyOutCents, plan, store } from '../../../../data/demo';

const [blocked, ...allowed] = inbox;
const cost = `$${plan.usage.costUsd} this plan, cache ${plan.usage.cacheHitPct}%`;
---
<Base title="ShopPilot+ console: Fern & Kiln demo store" description="Plan, check and approve shop work on a demo store. Nothing that moves money runs until you approve it.">
  <a class="skip" href="#main">Skip to content</a>
  <header class="app-head">
    <a class="wordmark" href="/v2/4/">ShopPilot+</a>
    <p class="app-store"><span class="pc-store-name">{store.name}</span> <span class="tag">Demo store</span> <span class="app-mode">Stripe test mode</span></p>
    <p class="app-cost"><span class="money">{cost}</span></p>
    <button class="btn btn--quiet" type="reset" form="console" data-reset>Reset demo store</button>
  </header>

  <main id="main" class="app-main">
    <h1 class="sr-only">ShopPilot+ console for the {store.name} demo store</h1>
    <div class="task">
      <form id="console" class="ask" novalidate>
        <label class="ask-label" for="ask">Ask ShopPilot+</label>
        <textarea id="ask" name="request" rows="3" aria-describedby="ask-err">{copy.request}</textarea>
        <p id="ask-err" class="ask-err" hidden>Type a request first, or pick one of the examples below.</p>
        <div class="ask-row">
          <button class="btn btn--primary" type="submit">Plan it</button>
          <ul class="chips" aria-label="Example requests">
            {chips.map((c) => <li><button class="chip" type="button" data-prompt={c.prompt}>{c.label}</button></li>)}
          </ul>
        </div>
      </form>

      <section class="plan" aria-labelledby="app-title">
        <PlanCard idp="app" form="console">
          <div class="pc-notes">
            <p class="replay"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4h4" /></svg>Recorded plan (replay)</p>
            <p class="blocked-note">1 inbox email was blocked from this plan. <a href="#inbox">See it</a></p>
          </div>
        </PlanCard>
      </section>
    </div>

    <aside id="inbox" class="rail" aria-label="Inbox, outbox and audit">
      <div class="tabs" role="tablist" aria-label="Messages and log">
        <button type="button" role="tab" id="tab-inbox" aria-controls="panel-inbox" aria-selected="true">Inbox (1 blocked)</button>
        <button type="button" role="tab" id="tab-outbox" aria-controls="panel-outbox" aria-selected="false" tabindex="-1">Outbox</button>
        <button type="button" role="tab" id="tab-audit" aria-controls="panel-audit" aria-selected="false" tabindex="-1">Audit</button>
      </div>
      <div role="tabpanel" id="panel-inbox" aria-labelledby="tab-inbox" class="panel">
        <article class="mail mail--blocked">
          <p class="verdict"><span class="stamp">BLOCKED</span> <span>{blocked.reason}</span></p>
          <p class="mail-from addr">{blocked.from}</p>
          <p class="mail-subject">{blocked.subject}</p>
          <p class="mail-preview">{blocked.preview}</p>
          <details class="tech">
            <summary>Technical details</summary>
            <p>Guard label <code class="mono">{blocked.label}</code>, score {blocked.score}. <span class="mono id">{blocked.id}</span></p>
          </details>
        </article>
        {allowed.map((m) => (
          <article class="mail">
            <p class="mail-top"><span class="pill pill--checked">Allowed</span> <span class="mail-reason">{m.reason}</span></p>
            <p class="mail-from addr">{m.from}</p>
            <p class="mail-subject">{m.subject}</p>
            <p class="mail-preview">{m.preview}</p>
          </article>
        ))}
      </div>
      <div role="tabpanel" id="panel-outbox" aria-labelledby="tab-outbox" class="panel" hidden>
        <p class="empty">Nothing in the Outbox yet. When step 2 runs, 3 tracking emails land here. They never leave the app.</p>
      </div>
      <div role="tabpanel" id="panel-audit" aria-labelledby="tab-audit" class="panel" hidden>
        <p class="empty">No actions yet. Every step you run writes a receipt here, with Undo where it is possible.</p>
      </div>
    </aside>

    <div class="runbar">
      <p class="runbar-money">Money out if you run: <span class="money">{money(moneyOutCents)}</span> <span class="runbar-mode">(Stripe test mode)</span></p>
      <p class="runbar-status" role="status" data-status></p>
      <button class="btn btn--primary" type="button" data-run>Run approved steps</button>
    </div>
  </main>
</Base>

<script>
  import '../../../../scripts/v2-4/console.ts';
</script>
