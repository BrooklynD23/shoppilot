---
import '@fontsource-variable/public-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../../../styles/v2-5.css';
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/v2-5/Icon.astro';
import StepRow from '../../../../components/v2-5/StepRow.astro';
import AuditReceipt from '../../../../components/v2-5/AuditReceipt.astro';
import ForecastChart from '../../../../components/v2-5/ForecastChart.astro';
import { hero, problem, proof, proofNote, howSteps, safety, anomalies, forecastCopy, pricing, pricingLabel, faq, closing, footer } from '../../../../data/v2';
import { plan, inbox, store } from '../../../../data/demo';
import { SAMPLES } from '../../../../scripts/v2-5/trick';

const APP = '/v2/5/app/';
const refund = plan.steps.find((s) => s.id === 's5')!;
const email = inbox[0];
const pillFor = { plan: 'pill-planned', check: 'pill-checked', approve: 'pill-approval', run: 'pill-done', undo: 'pill-undone' } as const;
const caps = [
  { rule: 'Refund cap per order', limit: '$200', then: 'Over the cap, a refund cannot be planned at all, whatever an email says.' },
  { rule: 'Refund cap per plan', limit: '$500', then: 'A plan that refunds more in total is refused before you see it.' },
  { rule: 'Refund window', limit: '30 days', then: 'Older orders are refused by the validator, with the reason shown.' },
  { rule: 'Approval gate', limit: 'Every money step', then: 'Waits for your checkbox. Nothing runs on its own.' },
  { rule: 'Audit and undo', limit: 'Every action', then: 'Logged with a receipt. Everything except a card refund can be undone.' },
];
const [h1a, h1b] = hero.h1.split('. ');
---
<Base title="ShopPilot+ | Safe autopilot for your shop" description={hero.sub} themeLight="#fbfbf8">
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav-wrap">
    <nav class="nav wrapx" aria-label="Main">
      <a class="wordmark" href="/v2/5/">ShopPilot+</a>
      <ul class="nav-links">
        <li><a href="#how">How it works</a></li>
        <li><a href="#safety">Safety</a></li>
        <li><a href="#pricing">Pricing</a></li>
      </ul>
      <a class="btn btn-primary nav-cta" href={APP}>{hero.cta}</a>
    </nav>
  </header>

  <main id="main">
    <!-- 1. Hero: positioning left, the real refund dry-run and receipt right -->
    <section class="hero wrapx" aria-labelledby="hero-h">
      <div class="hero-copy">
        <h1 id="hero-h">{h1a}. <span class="h1-line">{h1b}</span></h1>
        <p class="hero-sub">{hero.sub}</p>
        <a class="btn btn-primary btn-lg" href={APP}>{hero.cta}</a>
        <p class="hero-note">{hero.ctaNote}</p>
      </div>
      <div class="sheet hero-sheet" aria-label="Demo store: refund step waiting for approval">
        <div class="sheet-bar">
          <span><strong>{store.name}</strong> <span class="tag">Demo store</span></span>
          <span class="muted">Plan step 5 of 5</span>
        </div>
        <ol class="steps" start="5">
          <StepRow step={refund} titleTag="p" />
        </ol>
        <div class="sheet-sub">
          <p class="sheet-sub-h">Audit receipt</p>
          <AuditReceipt class="receipt-hero" />
        </div>
      </div>
    </section>

    <!-- 2. Safety (moved up: the fear is answered right after the hero) -->
    <section id="safety" class="safety section" aria-labelledby="safety-h">
      <div class="wrapx">
        <div class="safety-top">
          <div class="safety-story">
            <h2 id="safety-h">{safety.heading}</h2>
            <p class="lede">{safety.body}</p>
            <div class="email">
              <div class="email-head">
                <span class="stamp">BLOCKED</span>
                <span class="email-from wrap">From {email.from}</span>
              </div>
              <p class="email-subj">{email.subject}</p>
              <p class="email-why">{safety.verdictPlain}</p>
              <details class="tech">
                <summary>Technical detail</summary>
                <p>{safety.technical}</p>
              </details>
            </div>
          </div>

          <div class="trick">
            <h3>Try to trick it</h3>
            <p class="muted">Pick a sample attack or paste your own, then check it.</p>
            <form id="trick-form" class="trick-form" novalidate>
              <label for="trick-input">Email the agent might read</label>
              <textarea id="trick-input" rows="4" maxlength="500"></textarea>
              <div class="chips" role="group" aria-label="Sample attacks">
                {SAMPLES.map((s, i) => <button type="button" class="chip" data-sample={i}>{s.chip}</button>)}
              </div>
              <button type="submit" class="btn btn-ink">Check this email</button>
            </form>
            <div class="verdict" aria-live="polite">
              <p class="verdict-label">Sample verdicts written for this mockup (Demo store)</p>
              <p id="trick-hint" class="muted">Pick a sample or paste text, then check it.</p>
              <div id="verdict-blocked" hidden>
                <span id="verdict-stamp" class="stamp stamp-lg">BLOCKED</span>
                <p id="verdict-reason" class="verdict-reason"></p>
                <details class="tech">
                  <summary>Score</summary>
                  <p id="verdict-score"></p>
                </details>
              </div>
              <p id="verdict-none" hidden>In this mockup only the 3 samples have recorded verdicts. The live check runs on the server.</p>
            </div>
          </div>
        </div>

        <div class="caps">
          <h3 id="caps-h">The limits no email can change</h3>
          <div class="table-wrap">
            <table class="ledger-table" aria-labelledby="caps-h">
              <thead><tr><th scope="col">Rule</th><th scope="col">Limit</th><th scope="col">What happens</th></tr></thead>
              <tbody>
                {caps.map((c) => (
                  <tr><th scope="row">{c.rule}</th><td class="num cap-limit">{c.limit}</td><td>{c.then}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Proof -->
    <section class="proof section" aria-labelledby="proof-h">
      <div class="wrapx">
        <h2 id="proof-h">Measured so far, with the source on every number.</h2>
        <ul class="proof-strip">
          {proof.map((p) => (
            <li>
              <span class="proof-v num">{p.value}</span>
              <span class="proof-l">{p.label}</span>
              <span class="proof-s">{p.source}</span>
            </li>
          ))}
        </ul>
        <p class="muted">{proofNote}</p>
      </div>
    </section>

    <!-- 4. How a request runs -->
    <section id="how" class="how section" aria-labelledby="how-h">
      <div class="wrapx how-grid">
        <div class="how-intro">
          <h2 id="how-h">How a request runs</h2>
          <p class="lede">One sentence in. Five checks between it and your money.</p>
        </div>
        <ol class="how-list">
          {howSteps.map((h, i) => (
            <li>
              <span class="how-n num">{i + 1}</span>
              <div>
                <h3>{h.name}</h3>
                <p>{h.text}</p>
              </div>
              <span class={`pill ${pillFor[h.key]}`}>{h.pill}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. Forecast + anomalies -->
    <section class="forecast section" aria-labelledby="fc-h">
      <div class="wrapx fc-grid">
        <div class="sheet fc-sheet">
          <ForecastChart idPrefix="lfc" />
        </div>
        <div class="fc-copy">
          <h2 id="fc-h">{forecastCopy.heading}</h2>
          <p class="lede">{forecastCopy.body}</p>
          <h3 id="an-h">{forecastCopy.anomaliesHeading}</h3>
          <p class="tag">Demo store</p>
          <ul class="anomalies" aria-labelledby="an-h">
            {anomalies.map((a) => (
              <li>
                <span class="an-order">Order <code class="rid">{a.order}</code></span>
                <span>{a.reason}</span>
                <span class="an-score num">Flag score {a.score}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. Problem quote -->
    <section class="problem section" aria-labelledby="pq-h">
      <div class="wrapx">
        <h2 id="pq-h" class="sr-only">Why this exists</h2>
        <figure class="quote">
          <blockquote><p>{problem.quote}</p></blockquote>
          <figcaption>{problem.source}</figcaption>
        </figure>
        <p class="lede fear">{problem.fear}</p>
      </div>
    </section>

    <!-- 7. Planned pricing -->
    <section id="pricing" class="pricing section" aria-labelledby="pr-h">
      <div class="wrapx">
        <h2 id="pr-h">Pricing</h2>
        <p class="pricing-label"><Icon name="info" />{pricingLabel}</p>
        <ul class="tiers">
          {pricing.map((t) => (
            <li class="tier">
              <h3>{t.name}</h3>
              <p class="tier-price"><span class="num">{t.price}</span>{t.period && <span class="muted"> {t.period}</span>}</p>
              <p>{t.blurb}</p>
              <ul class="ticks">
                {t.features.map((f) => <li><Icon name="check" />{f}</li>)}
              </ul>
              {t.name === 'Demo'
                ? <a class="btn btn-primary" href={APP}>{t.cta}</a>
                : <button type="button" class="btn btn-ghost" disabled>Planned</button>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 8. FAQ / honest limits -->
    <section class="faq section" aria-labelledby="faq-h">
      <div class="wrapx faq-grid">
        <h2 id="faq-h">Questions and honest limits</h2>
        <div class="faq-list">
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 9. Closing band -->
    <section class="closing" aria-labelledby="cl-h">
      <div class="wrapx closing-in">
        <div>
          <h2 id="cl-h">{closing.heading}</h2>
          <p class="lede">{closing.body}</p>
        </div>
        <a class="btn btn-primary btn-lg" href={APP}>{hero.cta}</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrapx footer-in">
      <a class="wordmark" href="/v2/5/">ShopPilot+</a>
      <ul class="footer-links">
        {footer.links.map((l) => <li><a href={l.href.startsWith('/') ? l.href : `/v2/5/${l.href}`}>{l.label}</a></li>)}
      </ul>
      <p class="muted">{footer.course}</p>
    </div>
  </footer>
</Base>

<script>
  import { initTrick } from '../../../../scripts/v2-5/trick';
  initTrick();
</script>
