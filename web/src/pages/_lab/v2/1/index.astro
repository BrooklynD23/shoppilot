---
import '@fontsource-variable/mona-sans/wdth.css';
import '@fontsource-variable/jetbrains-mono';
import '../../../../styles/v2-1.css';
import Base from '../../../../layouts/Base.astro';
import PlanCard from '../../../../components/v2-1/PlanCard.astro';
import Pill from '../../../../components/v2-1/Pill.astro';
import ForecastChart from '../../../../components/v2-1/ForecastChart.astro';
import {
  hero, proof, proofNote, howSteps, safety, anomalies, forecastCopy,
  problem, pricing, pricingLabel, faq, closing, footer,
} from '../../../../data/v2';
import { inbox } from '../../../../data/demo';

const APP = '/v2/1/app/';
const ROOT = '/v2/1/';
const blocked = inbox[0];
const [h1a, h1b] = hero.h1.split('. ');
const pillKey = {
  plan: 'planned', check: 'checked', approve: 'approval', run: 'done', undo: 'undone',
} as const;
const footerLinks = footer.links.map((l) => ({ ...l, href: l.href.startsWith('/') ? l.href : ROOT + l.href }));
---
<Base title="ShopPilot+: see every dollar before it moves" description="Safe autopilot for your shop. ShopPilot+ plans orders, emails, restocks and refunds from one sentence, and waits for your approval before money moves.">
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav">
    <div class="wrap nav__in">
      <a class="wordmark" href={ROOT}>ShopPilot+</a>
      <nav aria-label="Main">
        <ul class="nav__links">
          <li><a href="#how">How it works</a></li>
          <li><a href="#safety">Safety</a></li>
          <li><a href="#pricing">Pricing</a></li>
        </ul>
      </nav>
      <a class="btn btn--primary nav__cta" href={APP}>{hero.cta}</a>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-h1">
      <div class="wrap hero__in">
        <div class="hero__text">
          <h1 id="hero-h1"><span>{h1a}.</span> <span>{h1b}</span></h1>
          <p class="hero__sub">{hero.sub}</p>
          <a class="btn btn--primary btn--lg" href={APP}>{hero.cta}</a>
          <p class="hero__note">{hero.ctaNote}</p>
        </div>
        <PlanCard variant="hero" appHref={APP} />
      </div>
    </section>

    <section class="proof band" aria-labelledby="proof-h">
      <div class="wrap">
        <h2 id="proof-h" class="sr">Measured so far</h2>
        <ul class="proof__row">
          {proof.map((p) => (
            <li class="stat">
              <p class="stat__n money">{p.value}</p>
              <p class="stat__label">{p.label}</p>
              <p class="stat__src">{p.source}</p>
            </li>
          ))}
        </ul>
        <p class="proof__note">{proofNote}</p>
      </div>
    </section>

    <section class="how" id="how" aria-labelledby="how-h">
      <div class="wrap">
        <h2 id="how-h">How a request runs</h2>
        <ol class="how__row">
          {howSteps.map((s, i) => (
            <li class="how__step">
              <div class="how__top">
                <span class="how__n">{i + 1}</span>
                <Pill state={pillKey[s.key]} />
              </div>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="safety band" id="safety" aria-labelledby="safety-h">
      <div class="wrap safety__in">
        <div class="safety__story">
          <h2 id="safety-h">{safety.heading}</h2>
          <p class="lede">{safety.body}</p>
          <article class="mail" aria-label="The blocked email">
            <div class="mail__head">
              <span class="stamp">BLOCKED</span>
              <p class="mail__from wrap-any">From {blocked.from}</p>
            </div>
            <p class="mail__subj">{blocked.subject}</p>
            <p class="mail__body">{blocked.preview}</p>
            <p class="mail__verdict">{safety.verdictPlain}</p>
            <details class="disclose">
              <summary>Technical details</summary>
              <p>{safety.technical}</p>
            </details>
          </article>
        </div>
        <div class="safety__rules">
          <h3>Hard limits the agent cannot talk its way past</h3>
          <dl class="caps">
            {safety.caps.map((c) => (
              <div><dt>{c.name}</dt><dd>{c.text}</dd></div>
            ))}
          </dl>
          <h3 id="audit-h">Audit receipt</h3>
          <ol class="receipt" aria-labelledby="audit-h">
            {safety.auditReceipt.map((r) => (
              <li>
                <span class="receipt__ts money">{r.ts}</span>
                <span class="receipt__what">
                  <span>{r.summary}</span>
                  <span class="receipt__ids"><code>{r.tool}</code> <code class="wrap-any">{r.id}</code></span>
                </span>
                <span class="receipt__undo">
                  {r.undo ? <span class="can-undo">Can undo</span> : <Pill state="irreversible" />}
                </span>
              </li>
            ))}
          </ol>
          <p class="fine">Card refunds have no Undo. The approve box says so before you tick it.</p>
        </div>
      </div>
    </section>

    <section class="forecast" aria-labelledby="fc-h">
      <div class="wrap">
        <div class="forecast__head">
          <h2 id="fc-h">{forecastCopy.heading}</h2>
          <p class="lede">{forecastCopy.body}</p>
        </div>
        <div class="forecast__grid">
          <div class="forecast__chart">
            <p class="tag">Demo store</p>
            <ForecastChart id="fc-land" class="chart--land" />
          </div>
          <div class="anoms">
            <h3>{forecastCopy.anomaliesHeading}</h3>
            <p class="tag">Demo store</p>
            <ul>
              {anomalies.map((a) => (
                <li>
                  <p class="anoms__order">Order <code>{a.order}</code></p>
                  <p>{a.reason}</p>
                  <p class="anoms__score">Anomaly score <span class="money">{a.score}</span></p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="problem band" aria-labelledby="problem-h">
      <div class="wrap">
        <h2 id="problem-h" class="sr">Why this exists</h2>
        <figure class="quote">
          <blockquote><p>{problem.quote}</p></blockquote>
          <figcaption>{problem.source}</figcaption>
        </figure>
        <p class="problem__fear">{problem.fear}</p>
      </div>
    </section>

    <section class="pricing" id="pricing" aria-labelledby="pricing-h">
      <div class="wrap">
        <div class="pricing__head">
          <h2 id="pricing-h">Pricing</h2>
          <p class="pricing__label">{pricingLabel}</p>
        </div>
        <ul class="tiers">
          {pricing.map((t, i) => (
            <li class:list={['tier', { 'tier--demo': i === 0 }]}>
              <h3>{t.name}</h3>
              <p class="tier__price"><span class="money">{t.price}</span> {t.period && <span class="tier__period">{t.period}</span>}</p>
              <p class="tier__blurb">{t.blurb}</p>
              <ul class="tier__feats">
                {t.features.map((f) => (
                  <li>
                    <svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" /></svg>
                    {f}
                  </li>
                ))}
              </ul>
              {i === 0
                ? <a class="btn btn--primary" href={APP}>{t.cta}</a>
                : <button class="btn btn--quiet" type="button" disabled>{t.cta}</button>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="faq band" aria-labelledby="faq-h">
      <div class="wrap faq__in">
        <h2 id="faq-h">Questions and honest limits</h2>
        <div class="faq__list">
          {faq.map((f) => (
            <details class="disclose disclose--faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-h">
      <div class="wrap closing__in">
        <div>
          <h2 id="closing-h">{closing.heading}</h2>
          <p class="lede">{closing.body}</p>
        </div>
        <a class="btn btn--primary btn--lg" href={APP}>{hero.cta}</a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot__in">
      <a class="wordmark" href={ROOT}>ShopPilot+</a>
      <nav aria-label="Footer">
        <ul class="foot__links">
          {footerLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <p class="foot__course">{footer.course}</p>
    </div>
  </footer>
</Base>
