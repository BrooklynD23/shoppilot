---
// Handling marks drawn in the ISO 780 manner: 24px grid, 2px stroke, currentColor.
// With `label` the mark is an image with a name; without it, decoration only.
type Kind = 'up' | 'fragile' | 'dry' | 'undo' | 'record' | 'tick' | 'arrow' | 'stop';
interface Props { kind: Kind; label?: string; class?: string }
const { kind, label, class: cls = '' } = Astro.props;
const paths: Record<Kind, string> = {
  up: 'M7 19V5M3.5 8.5 7 5l3.5 3.5M17 19V5M13.5 8.5 17 5l3.5 3.5M3 21h18',
  fragile: 'M6.5 2.5h11c0 6-2.4 9.5-5.5 9.5s-5.5-3.5-5.5-9.5ZM12 12v8M8 21h8M11 2.5l1.6 2.6-1.8 2.2 1.2 1.9',
  dry: 'M3.5 13a8.5 7 0 0 1 17 0ZM12 13v6a2 2 0 0 1-4 0M6 2v2.5M12 1.5V4M18 2v2.5',
  undo: 'M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5',
  record: 'M3 7.5 12 3l9 4.5v9L12 21l-9-4.5ZM3 7.5 12 12l9-4.5M12 12v9',
  tick: 'M4.5 12.5 9.5 17.5 19.5 7',
  arrow: 'M2 12h18M14.5 6.5 20 12l-5.5 5.5',
  stop: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM5.6 5.6l12.8 12.8',
};
---
{label ? (
  <svg class={`mk ${cls}`} viewBox="0 0 24 24" role="img" aria-label={label} focusable="false">
    <title>{label}</title>
    <path d={paths[kind]} />
  </svg>
) : (
  <svg class={`mk ${cls}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d={paths[kind]} />
  </svg>
)}
