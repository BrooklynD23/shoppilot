---
// The cut edge of the board: two liners and the fluted medium between them.
// Only ever used where the carton is cut, never as a page texture.
interface Props { id: string }
const { id } = Astro.props;
---
<svg class="flute" width="100%" height="18" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={id} width="18" height="18" patternUnits="userSpaceOnUse">
      <rect class="flute-gap" width="18" height="18" />
      <path class="flute-wave" d="M0 15C4.5 15 4.5 3 9 3S13.5 15 18 15" />
    </pattern>
  </defs>
  <rect width="100%" height="18" fill={`url(#${id})`} />
  <line class="flute-liner" x1="0" x2="100%" y1="1" y2="1" />
  <line class="flute-liner" x1="0" x2="100%" y1="17" y2="17" />
</svg>
