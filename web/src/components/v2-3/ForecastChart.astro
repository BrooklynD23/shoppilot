---
// Forecast band (spec 06 §6). Same markup on the landing and in console step 3.
import { chartPaths, forecast } from '../../data/demo';
interface Props { uid: string }
const { uid } = Astro.props;
const c = chartPaths();
const ticks = [0, 7, 14];
---
<figure class="fc">
  <svg viewBox="0 0 280 120" role="img" aria-labelledby={`${uid}-t ${uid}-d`}>
    <title id={`${uid}-t`}>Demand forecast for {forecast.product}</title>
    <desc id={`${uid}-d`}>{forecast.caption}</desc>
    <path class="fc-band" d={c.band} />
    <path class="fc-p50" d={c.p50} />
    <path class="fc-hand" d={`M${c.x(0)} ${c.onHandY}H${c.x(14)}`} />
    <text class="fc-t" x={c.x(14)} y={c.onHandY - 5} text-anchor="end">On hand {forecast.onHand}</text>
    <path class="fc-mark" d={`M${c.markerX} 12V104`} />
    <text class="fc-t" x={c.markerX + 5} y={20}>Runs out about day {forecast.daysToStockout}</text>
    {ticks.map((d) => <text class="fc-ax" x={c.x(d)} y={117} text-anchor="middle">Day {d}</text>)}
  </svg>
  <figcaption>{forecast.caption}</figcaption>
</figure>
