---
// One stroke family: 16px grid, 1.6 stroke, round caps. Decorative unless a label is passed.
type Name = 'tick' | 'arrow' | 'x' | 'lock' | 'alert' | 'box' | 'box-ticked' | 'undo' | 'mail' | 'shield';
interface Props { name: Name; class?: string }
const { name, class: cls = '' } = Astro.props;
const paths: Record<Name, string[]> = {
  tick: ['M3.5 8.5l3 3 6-7'],
  arrow: ['M2.5 8h11', 'M9.5 4l4 4-4 4'],
  x: ['M4 4l8 8', 'M12 4l-8 8'],
  lock: ['M4 7.5h8v6H4z', 'M5.5 7.5V5.5a2.5 2.5 0 0 1 5 0v2'],
  alert: ['M8 2.5l6 11H2z', 'M8 7v3', 'M8 12v.01'],
  box: ['M2.5 2.5h11v11h-11z'],
  'box-ticked': ['M2.5 2.5h11v11h-11z', 'M5 8.2l2 2 4-4.5'],
  undo: ['M5 4L2.5 6.5 5 9', 'M2.5 6.5H10a3.5 3.5 0 0 1 0 7H7'],
  mail: ['M2 3.5h12v9H2z', 'M2 4l6 5 6-5'],
  shield: ['M8 1.8l5 2v4c0 3.2-2.2 5.3-5 6.4-2.8-1.1-5-3.2-5-6.4v-4z', 'M5.8 8.2l1.6 1.6 3-3.2'],
};
---
<svg class={`ico ${cls}`} viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
  {paths[name].map((d) => <path d={d} />)}
</svg>
