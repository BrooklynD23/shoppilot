---
import { forecast, chartPaths } from '../../data/demo';
interface Props { idPrefix: string }
const { idPrefix } = Astro.props;
const c = chartPaths();
const ticks = [0, 7, 14];
---
<figure class="chart">
  <svg viewBox="0 0 280 120" role="img" aria-labelledby={`${idPrefix}-t ${idPrefix}-d`}>
    <title id={`${idPrefix}-t`}>Demand forecast for {forecast.product}</title>
    <desc id={`${idPrefix}-d`}>{forecast.caption}</desc>
    <line class="axis" x1="16" x2="264" y1="104" y2="104" />
    <path class="band" d={c.band} />
    <path class="p50" d={c.p50} />
    <line class="onhand" x1="16" x2="264" y1={c.onHandY} y2={c.onHandY} />
    <text x="264" y={c.onHandY - 5} text-anchor="end">On hand {forecast.onHand}</text>
    <line class="marker" x1={c.markerX} x2={c.markerX} y1="14" y2="104" />
    <text x={c.markerX + 5} y="22">Runs out ~day {forecast.daysToStockout}</text>
    {ticks.map((d) => (
      <>
        <line class="axis" x1={c.x(d)} x2={c.x(d)} y1="104" y2="108" />
        <text class="tick" x={c.x(d)} y="118" text-anchor="middle">{d === 0 ? 'Day 0' : d}</text>
      </>
    ))}
  </svg>
  <figcaption>{forecast.caption}</figcaption>
</figure>
