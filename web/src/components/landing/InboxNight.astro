---
// Problem: the demo-store inbox before the run, the same emails GET /api/inbox returns (src/data/run.ts).
// Unread dots are ink: amber is money only.
import { inbox } from '../../data/run';
---
<article class="inbox panel" data-ui aria-label="Inbox, demo store">
  <header class="panel-head">
    <p class="panel-title">Inbox</p>
    <p class="panel-meta"><span class="num">{inbox.length}</span> unread</p>
    <span class="tag">Demo store</span>
  </header>
  <ol class="inbox-list">
    {inbox.map((m) => (
      <li class="inbox-row">
        <span class="inbox-dot" aria-hidden="true"></span>
        <p class="inbox-subj">{m.subject}</p>
        <p class="inbox-from addr">{m.from}</p>
        <time class="inbox-ts num" datetime={m.at}>{m.when}</time>
      </li>
    ))}
  </ol>
</article>
