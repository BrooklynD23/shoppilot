---
// Hero product: the recorded plan (src/data/run.ts, the console's own fixture) as a terminal-like table,
// and the approval card beside it in its own grid column: nothing overlaps, so nothing can collide.
// Every status is final in the markup; nothing animates in.
// The approval checkbox is real: :has() swaps "Needs approval" and "Money out" with zero JS.
import { planId, request, steps, gated, refund, moneyOutCents, money } from '../../data/run';
import Icon from './Icon.astro';

const [whole, frac] = money(refund.cents).split('.');
---
<div class="stage" data-ui>
  <article class="plan panel" aria-label="Plan, demo store">
    <header class="panel-head">
      <p class="panel-title">Plan <code class="id">{planId}</code></p>
      <p class="panel-meta">{steps.length} steps, {gated} {gated === 1 ? 'needs' : 'need'} your approval</p>
      <span class="tag">Demo store</span>
    </header>
    <p class="plan-ask"><Icon name="chev" class="plan-caret" /><span>{request}</span></p>
    <ol class="plan-steps">
      {steps.map((s) => (
        <li class:list={['ps', { 'ps--money': s.moneyOut }]}>
          <span class="ps-n num" aria-hidden="true">{s.n}</span>
          <span class="ps-main">
            <span class="ps-title">{s.title}</span>
            <code class="tool">{s.tool}</code>
          </span>
          <span class:list={['ps-amt num', { money: s.moneyOut }]}>{s.cents != null && `${money(s.cents)}${s.moneyOut ? '' : ' est.'}`}</span>
          {s.gated
            ? <span class="ps-state"><span class="pill pill--approval st-wait">Needs approval</span><span class="pill pill--done st-ok">Approved</span></span>
            : <span class="ps-state"><span class="pill pill--checked">Checked</span></span>}
        </li>
      ))}
    </ol>
    <footer class="panel-foot">
      <p class="plan-out">Money out if you run <span class="plan-out-v num"><span class="st-wait">{money(0)}</span><span class="st-ok money">{money(moneyOutCents)}</span></span></p>
    </footer>
  </article>

  <article class="appr panel" aria-label={`Approval, step ${refund.n}`}>
    <p class="appr-head"><span class="appr-step">Step {refund.n}</span><span class="appr-what">{refund.why}</span></p>
    <p class="appr-amt num money">{whole}<span class="cents">.{frac}</span></p>
    <label class="appr-check">
      <input type="checkbox" />
      <span>Approve this refund. Card refunds cannot be undone.</span>
    </label>
  </article>
</div>
