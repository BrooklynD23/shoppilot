---
// The restock step's stock forecast, from the recorded run (src/data/run.ts), drawn from the same parts as the
// console's chart (src/scripts/console/chart.ts forecastParts) so the landing and /app/ show one picture:
// projected stock clamped at 0, 80% band, the line ends on the "Out of stock" floor.
import { forecast as f, forecastCaption } from '../../data/run';
import { forecastParts } from '../../scripts/console/chart';
interface Props { id: string }
const { id } = Astro.props;
const p = forecastParts(f);
---
<figure class="chart">
  <svg height={p.height} role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Stock forecast for {f.name}</title>
    <desc id={`${id}-d`}>{forecastCaption}</desc>
    <svg viewBox={p.viewBox} preserveAspectRatio="none">
      {p.plot.map(({ tag: Tag, attrs, text }) => <Tag {...attrs}>{text}</Tag>)}
    </svg>
    {p.marks.map(({ tag: Tag, attrs, text }) => <Tag {...attrs}>{text}</Tag>)}
  </svg>
  <figcaption>{forecastCaption} Shaded: 80% range.</figcaption>
</figure>
