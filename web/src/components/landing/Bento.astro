---
// Product tiles: a title, a hairline, one real fragment. One surface per tile (no card in a card).
// Only what no other section shows: the Forecaster's two outputs, the stock forecast and the odd-order flags.
// The plan, its checks and the receipts live in the hero, the team and the morning run.
// Every result carries its source and its caveat, at body size. Amber only where money moves.
import { flags } from '../../data/run';
import { product } from '../../data/landing';
import ForecastChart from './ForecastChart.astro';

const t = product.tiles;
const { forecastStat: fs, flagStat: gs } = product;
---
<ul class="bento">
  <li class="tile">
    <h3>{t.forecast}</h3>
    <div class="tile-ui" data-ui>
      <ForecastChart id="bt-fc" />
      <p class="stat">{fs.text}</p>
      <span class="tag">{fs.source}</span>
    </div>
  </li>

  <li class="tile">
    <h3>{t.flags}</h3>
    <div class="tile-ui" data-ui>
      <ol class="flag-list">
        {flags.map((a) => (
          <li>
            <p class="flag-head"><code class="id">{a.order}</code><span class="pill pill--flag">Score <span class="num">{a.score}</span></span></p>
            <p class="flag-why">{a.reason}</p>
          </li>
        ))}
      </ol>
      <p class="stat">{gs.text}</p>
      <span class="tag">{gs.source}</span>
    </div>
  </li>
</ul>
