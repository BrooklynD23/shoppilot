---
// Morning band: the finished run. All five steps Done; the refund is Irreversible (no Undo, ever).
import { plan, money, store } from '../../data/demo';
import { safety } from '../../data/v2';
import Icon from './Icon.astro';

const byTool = Object.fromEntries(safety.auditReceipt.map((r) => [r.tool, r]));
const out = plan.steps.filter((s) => s.movesMoney).reduce((t, s) => t + (s.amountCents ?? 0), 0);
---
<article class="rundone" data-ui aria-label="Finished run, demo store">
  <header class="rd-head">
    <p class="rd-title"><Icon name="tick" />Run complete <code class="id">{plan.planId}</code></p>
    <span class="tag">{store.name}, demo store</span>
  </header>
  <ol class="rd-steps">
    {plan.steps.map((s) => {
      const r = byTool[s.tool];
      return (
        <li class:list={['rd-step', { 'rd-step--money': s.movesMoney }]}>
          <span class="step-n num" aria-hidden="true">{s.n}</span>
          <div class="rd-main">
            <p class="rd-t">{s.title}{s.movesMoney && <span class="num money"> {money(s.amountCents ?? 0)}</span>}</p>
            <p class="receipt-ids">
              {r && <span class="num">{r.ts}</span>}
              <code class="tool">{s.tool}</code>
              {r && <code class="id">{r.id}</code>}
            </p>
          </div>
          <span class="rd-pills">
            <span class="pill pill--done">Done</span>
            {s.movesMoney && <span class="pill pill--irreversible">Irreversible</span>}
          </span>
        </li>
      );
    })}
  </ol>
  <footer class="rd-foot">
    <p>Money out <span class="num money">{money(out)}</span></p>
    <p class="rd-note">Approved by you, Stripe test mode</p>
  </footer>
</article>
