---
// Morning: the finished run as audit receipts, oldest first, from the console's recorded execute results
// (src/data/run.ts). Refunds are final: never an Undo on refund_order. The clock times are the story's.
import { planId, receipts, moneyOutCents, money } from '../../data/run';
import { morning } from '../../data/landing';
import Icon from './Icon.astro';

if (receipts.length > morning.runAt.length) throw new Error('landing.ts morning.runAt needs one time per receipt');
const rows = receipts.map((r, i) => ({ ...r, ts: morning.runAt[i] }));
---
<article class="run panel" data-ui aria-label="Finished run, demo store">
  <header class="panel-head">
    <p class="panel-title"><Icon name="tick" class="run-ok" />Run complete <code class="id">{planId}</code></p>
    <span class="tag">Demo store</span>
  </header>
  <table class="run-t">
    <thead class="sr-only"><tr><th scope="col">Time</th><th scope="col">Receipt</th><th scope="col">Undo</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td class="run-ts num">{r.ts}</td>
          <td class="run-what"><span class="run-sum">{r.text}</span> <span class="run-ids"><code class="tool">{r.tool}</code> <code class="id">{r.id}</code></span></td>
          <td class="run-undo">{r.undo ? <span class="undo"><Icon name="undo" />Undo</span> : <span class="pill pill--irreversible">Irreversible</span>}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <footer class="panel-foot">
    <p class="run-out">Money out <span class="num money">{money(moneyOutCents)}</span></p>
    <p class="panel-meta">Approved by you at <span class="num">{morning.approvedAt}</span></p>
  </footer>
</article>
