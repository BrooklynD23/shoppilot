---
// 6 bento tiles, each a real UI fragment with its short title. Approve + Audit are the large tiles.
// The approve checkbox works with zero JS: :has(input:checked) swaps the money-out figure.
import { plan, inbox, money } from '../../data/demo';
import { anomalies } from '../../data/v2';
import { bento } from '../../data/v3';
import Icon from './Icon.astro';
import Receipt from './Receipt.astro';
import ForecastChart from './ForecastChart.astro';

const t = Object.fromEntries(bento.tiles.map((x) => [x.key, x.title]));
const refund = plan.steps.find((s) => s.movesMoney)!;
const order = refund.title.replace(/^Refund /, '');
const diffs = plan.steps.filter((s) => ['mark_shipped', 'send_email', 'create_restock_po'].includes(s.tool));
const blocked = inbox[0];
---
<ul class="bento">
  <li class="tile tile--approve">
    <h3>{t.approve}</h3>
    <div class="inset bt-approve" data-ui>
      <div class="bt-step">
        <span class="step-n num" aria-hidden="true">{refund.n}</span>
        <p class="step-title">{refund.title}</p>
        <p class="step-money num">{money(refund.amountCents ?? 0)}</p>
      </div>
      <label class="check bt-check">
        <input type="checkbox" />
        <span>Approve refund of {money(refund.amountCents ?? 0)} on {order}. Card refunds cannot be undone.</span>
      </label>
      <div class="bt-out">
        <span class="out-label">Money out if you run</span>
        <span class="out-value num"><span class="bt-off">{money(0)}</span><span class="bt-on">{money(refund.amountCents ?? 0)}</span></span>
        <span class="pill pill--blocked">Irreversible</span>
      </div>
    </div>
  </li>

  <li class="tile tile--guard">
    <h3>{t.guard}</h3>
    <div class="inset bt-guard" data-ui>
      <div class="mail-head">
        <span class="stamp">BLOCKED</span>
        <code class="id">{blocked.label}</code>
        <span class="bt-score num">{blocked.score}</span>
      </div>
      <p class="mail-subj">{blocked.subject}</p>
    </div>
  </li>

  <li class="tile tile--diff">
    <h3>{t.diff}</h3>
    <ol class="inset bt-diff" data-ui>
      {diffs.map((s) => (
        <li>
          <code class="tool">{s.tool}</code>
          <span class="diff"><span class="diff-before">{s.before}</span><Icon name="arrow" class="diff-arrow" /><span>{s.after}</span></span>
        </li>
      ))}
    </ol>
  </li>

  <li class="tile tile--forecast">
    <h3>{t.forecast}</h3>
    <div class="inset" data-ui>
      <ForecastChart id="bt-fc" />
    </div>
  </li>

  <li class="tile tile--anomaly">
    <h3>{t.anomaly}</h3>
    <ol class="inset bt-anoms" data-ui>
      {anomalies.map((a) => (
        <li>
          <p class="bt-anom-head"><code class="id">#{a.order}</code><span class="pill pill--approval">Flagged <span class="num">{a.score}</span></span></p>
          <p class="bt-anom-why">{a.reason}</p>
        </li>
      ))}
    </ol>
  </li>

  <li class="tile tile--audit">
    <h3>{t.audit}</h3>
    <div class="inset" data-ui>
      <Receipt />
    </div>
  </li>
</ul>
