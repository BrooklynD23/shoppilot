---
// Animated real-UI walkthrough: 5 scenes on one 11 s CSS cycle (v3-a.css, .loop).
// Pause checkbox -> animation-play-state: paused via :has(). Reduced motion: final scene, static.
import { plan, inbox, copy, money, store } from '../../data/demo';
import { how } from '../../data/v3';
import Icon from './Icon.astro';
import Receipt from './Receipt.astro';

const blocked = inbox[0];
const refund = plan.steps.find((s) => s.movesMoney)!;
const order = refund.title.replace(/^Refund /, '');
const cut = copy.request.indexOf(', restock');
const lines = [copy.request.slice(0, cut + 1), copy.request.slice(cut + 2)];
---
<div class="loop-wrap">
  <ol class="track">
    {how.steps.map((s, i) => (
      <li class={`track-item track-item--${i + 1}`}><span class="track-n num" aria-hidden="true">{i + 1}</span>{s}</li>
    ))}
  </ol>

  <figure class="loop" data-ui>
    <figcaption class="loop-bar">
      <span class="loop-title">{how.loopLabel}</span>
      <span class="tag">{store.name}</span>
      <label class="loop-pause">
        <input type="checkbox" />
        <span class="lp lp-pause"><Icon name="pause" />Pause</span>
        <span class="lp lp-play"><Icon name="play" />Play</span>
      </label>
    </figcaption>

    <div class="loop-screen" aria-hidden="true">
      <section class="scene scene--1">
        <p class="sc-label">Ask ShopPilot+</p>
        <div class="sc-ask">
          {lines.map((l, i) => <span class={`sc-type sc-type--${i + 1}`}>{l}</span>)}
        </div>
        <span class="btn btn-primary btn-sm sc-press">Plan it</span>
      </section>

      <section class="scene scene--2">
        <p class="sc-label">Plan <span class="sc-dim">{plan.steps.length} steps, all checked</span></p>
        <ol class="sc-steps">
          {plan.steps.map((s) => (
            <li class="sc-step">
              <span class="step-n num">{s.n}</span>
              <span class="sc-step-t">{s.title}</span>
              <span class="pill pill--checked">Checked</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="scene scene--3">
        <p class="sc-label">Inbox <span class="sc-dim">screened before planning</span></p>
        <article class="mail sc-mail">
          <div class="mail-head">
            <span class="stamp">BLOCKED</span>
            <span class="mail-from addr">{blocked.from}</span>
          </div>
          <p class="mail-subj">{blocked.subject}</p>
          <p class="mail-verdict">{blocked.reason}</p>
        </article>
      </section>

      <section class="scene scene--4">
        <p class="sc-label">Step 5 <span class="sc-dim">moves money</span></p>
        <div class="sc-approve">
          <span class="sc-box"><Icon name="tick" /></span>
          <span>Approve refund of <span class="num money">{money(refund.amountCents ?? 0)}</span> on {order}. Card refunds cannot be undone.</span>
          <span class="pill pill--blocked">Irreversible</span>
        </div>
        <p class="sc-out">Money out if you run <span class="num money">{money(refund.amountCents ?? 0)}</span></p>
      </section>

      <section class="scene scene--5">
        <p class="sc-label sc-done"><Icon name="tick" />Done. Every step is in the audit log.</p>
        <Receipt pick={['refund_order', 'create_restock_po', 'send_email']} />
      </section>
    </div>
  </figure>
</div>
