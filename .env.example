# test-mode keys only (sk_test_... or rk_test_...); never commit real values
APP_ENV=dev
DATA_DIR=/tmp/shoppilot
SESSION_TTL_HOURS=24
MAX_SESSIONS=100
PLAN_TTL_MINUTES=15
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-haiku-5-5
PLANNER_EFFORT=medium
# live|replay|record (default: replay when APP_ENV=test, else live)
LLM_MODE=
# Anthropic spend caps (user decision 2026-11-02: Haiku 5.5 only, $2 a day, $0.25 a session)
LLM_DAILY_BUDGET_USD=2.0
LLM_SESSION_BUDGET_USD=0.25
LLM_MAX_PLANS_PER_SESSION_HOUR=20
STRIPE_SECRET_KEY=
STRIPE_MODE=auto
STRIPE_MAX_WRITES_PER_SESSION=20
RUN_LIVE=

# Stripe Connect sample (spec 10, docs/connect-setup.md). Off unless CONNECT_ENABLED=1.
# Uses STRIPE_SECRET_KEY above (sandbox only). An empty value counts as unset.
# PLACEHOLDER: 1 turns on the /connect/ pages and /api/connect/*. Leave empty for the demo.
CONNECT_ENABLED=
# PLACEHOLDER: this server's address, no trailing slash. Local: http://localhost:8000
#              Render: https://<service>.onrender.com (must be https when APP_ENV=prod)
PUBLIC_BASE_URL=
# PLACEHOLDER: price_... printed by `uv run python scripts/create_platform_price.py` (not a secret)
STRIPE_PLATFORM_PRICE_ID=
# PLACEHOLDER: whsec_... printed by the thin-events `stripe listen` (local) or the thin destination
STRIPE_CONNECT_THIN_WEBHOOK_SECRET=
# PLACEHOLDER: whsec_... printed by the billing `stripe listen` (local) or the snapshot destination
STRIPE_BILLING_WEBHOOK_SECRET=
# Optional: the platform fee on each storefront sale, in cents (default 123, the brief's sample)
CONNECT_APPLICATION_FEE_CENTS=
