# test-mode keys only (sk_test_... or rk_test_...); never commit real values
APP_ENV=dev
DATA_DIR=/tmp/shoppilot
SESSION_TTL_HOURS=24
MAX_SESSIONS=100
PLAN_TTL_MINUTES=15
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-haiku-5-5
PLANNER_EFFORT=medium
# live|replay|record (default: replay when APP_ENV=test, else live)
LLM_MODE=
LLM_DAILY_BUDGET_USD=5.0
LLM_SESSION_BUDGET_USD=0.5
LLM_MAX_PLANS_PER_SESSION_HOUR=20
STRIPE_SECRET_KEY=
STRIPE_MODE=auto
STRIPE_MAX_WRITES_PER_SESSION=20
RUN_LIVE=
